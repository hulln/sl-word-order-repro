    given-names: "Nives"
    affiliation: "University of Ljubljana"
keywords:
  - word order
  - Slovenian
  - Universal Dependencies
  - corpus linguistics
  - reproducibility
references:
  - type: thesis
    title: >-
      Besedni red v slovenskih besedilih: Korpusna analiza žanrske in slogovne
      variacije z metodami NLP
    authors:
      - family-names: "Hüll"
        given-names: "Nives"
    thesis-type: "Master's thesis"
    institution:
      name: "University of Ljubljana"
